# Day 6 vector store (same Docker container as Day 6: day6_student_starter)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
DAY6_STRATEGY=C
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Agent model: DeepSeek API (OpenAI-compatible chat completions with tool calling)
# Paste your own key into .env (never commit .env).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat
